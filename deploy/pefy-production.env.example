# PEFY Agent Workforce production environment template
# Copy outside source control, replace placeholders, restrict permissions, and inject through the approved secret-management path.

PEFY_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_DB=mission_control
POSTGRES_USER=mission_control
POSTGRES_PASSWORD=REPLACE_WITH_SECRET

# Use false after migrations are explicitly managed in the release process.
DB_AUTO_MIGRATE=false

# local or clerk
AUTH_MODE=local
LOCAL_AUTH_TOKEN=REPLACE_WITH_MINIMUM_32_CHARACTER_SECRET
CLERK_ISSUER=
CLERK_AUDIENCE=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

BASE_URL=https://api.example.invalid
NEXT_PUBLIC_API_URL=https://api.example.invalid
CORS_ORIGINS=https://mission-control.example.invalid

RQ_QUEUE_NAME=default
RQ_DISPATCH_THROTTLE_SECONDS=2.0
RQ_DISPATCH_MAX_RETRIES=3

# Smoke pack inputs (normally exported only for verification, not consumed by Compose).
PEFY_MC_BACKEND_URL=https://api.example.invalid
PEFY_MC_FRONTEND_URL=https://mission-control.example.invalid

# Backup: use an age recipient; keep the matching private identity outside this repository.
PEFY_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
PEFY_BACKUP_DIR=./backups/mission-control
